# ===== 存储模式 =====
# 支持 file, mysql, postgres 或 redis
STORAGE_MODE=redis

# ===== 数据库 =====
# STORAGE_MODE 非 file 时必填
# Redis格式: redis://host:port/db 或 redis://:password@host:port/db
# PostgreSQL格式: postgres://user:password@host:port/database
# MySQL格式: mysql://user:password@host:port/database
DATABASE_URL=redis://localhost:6379/0
# DATABASE_URL=postgres://postgres:password@localhost:5432/grok2api

# ===== Worker数量 =====
# 默认1，建议：CPU核心数 * 2，多进程模式下建议使用数据库存储
WORKERS=1

# ===== 管理员账号 =====
# 环境变量优先级高于配置文件
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
